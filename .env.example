# ============================================================
# AI SIGNBOARD STUDIO — biến môi trường (MẪU, KHÔNG ĐIỀN KEY THẬT)
# Copy thành .env.local và điền giá trị thật. .env.local KHÔNG BAO GIỜ commit.
# Quy tắc: credentials chỉ đến từ biến môi trường — cấm ghi key thật
# vào source code, ví dụ, test, hay log.
# ============================================================

# --- Gemini (Google AI Studio) ---------------------------------
# Platform key mặc định của app (Free Tier)
GEMINI_API_KEY=
# Tên model — đặt ở env để đổi model không cần deploy lại
# (dùng bản Flash mới nhất tại thời điểm build)
GEMINI_MODEL=

# --- Supabase --------------------------------------------------
# Client-side (an toàn khi expose, được bảo vệ bởi RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server (API routes) — bypass RLS, tuyệt đối không expose
SUPABASE_SERVICE_ROLE_KEY=
# Secret để hash IP trước khi lưu vào ai_usage.ip_hash (không lưu IP thô)
IP_HASH_SECRET=

# --- Bảo vệ cron giữ DB sống -----------------------------------
# Vercel Cron gọi /api/cron/keepalive với header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
